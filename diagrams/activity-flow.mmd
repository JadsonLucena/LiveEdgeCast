flowchart TD
    A[Cliente inicia publish RTMP no LB] --> B[LB HAProxy balance leastconn]
    B --> C[Proxy recebe stream /live/{streamKey}]
    C --> D[NGINX exec_publish -> on_publish_start.sh]
    D --> E[POST /streams/started?stream&proxy_pod]

    E --> F{Controller register_stream\ntry_handover_stream_owner}
    F -->|novo owner ou replay| G[Atualiza stream_registry + stream_to_proxy\npersist_state_locked]
    F -->|conflito ownership| Z1[HTTP 409]

    G --> H{allocate_worker\nstream já tem worker?}
    H -->|sim| I[Retorna idempotent_replay]
    H -->|não| J[resolve_proxy_address(owner)]
    J --> K[create_worker_pod_for_stream]
    K --> L[Injeta env STREAM_KEY e PROXY_DNS]
    L --> M[core.create_namespaced_pod]
    M --> N[Atualiza stream_to_worker + worker_to_stream\npersist_state_locked]

    N --> O[Worker entrypoint.sh]
    O --> P[Inicia worker_stream_runner.sh + nginx daemon off]
    P --> Q[FFmpeg pull rtmp://PROXY_DNS/live/STREAM_KEY]
    Q --> R[FFmpeg push RTMP destino]

    %% Fim canônico
    S[Cliente para publish] --> T[Proxy drop_idle_publisher 60s]
    T --> U[exec_publish_done -> on_publish_done.sh]
    U --> V[POST /streams/ended?stream&proxy_pod]
    V --> W[Controller stream_ended]
    W --> X[release_worker: remove mappings + delete pod\npersist_state_locked]

    %% Reconciliação Proxy
    subgraph PROXY_RECON[Reconciliação de Saúde do Proxy]
      P1[Loop a cada 3s + jitter 1.5s] --> P2[get_proxy_health_status(proxy)]
      P2 -->|not_ready/warming_up| P3[Não conta falha]
      P2 -->|healthy| P4[Zera proxy_health_failures]
      P2 -->|unhealthy| P5[Incrementa falhas]
      P5 -->|>=3| P6[Expira ownership da stream\nremove registry/proxy/worker mappings\ndeleta worker pod\npersist_state_locked]
    end

    %% Reconciliação Worker
    subgraph WORKER_RECON[Reconciliação de Saúde do Worker]
      W1[Loop a cada 3s + jitter 1.5s] --> W2[Lê pod worker + UID]
      W2 --> W3{Worker Ready + delay pós-ready?}
      W3 -->|não| W4[Reseta/pausa contagem]
      W3 -->|sim| W5{Owner proxy healthy?}
      W5 -->|não| W6[Skip check worker]
      W5 -->|sim| W7[check_worker_health /health]
      W7 -->|healthy| W8[Zera falhas por UID]
      W7 -->|falha| W9[Incrementa falhas por UID]
      W9 -->|>=3| W10[Cria worker novo\natualiza mappings\ndeleta worker antigo\npersist_state_locked]
    end

    %% Handover
    Y1[Mesmo streamKey em outro proxy] --> Y2[try_handover_stream_owner]
    Y2 -->|owner atual unhealthy/deletado| Y3[Transfere ownership\nstream_generation++]
    Y3 --> Y4[Se já houver worker: replace_worker_pod_for_stream_locked\npara atualizar PROXY_DNS]
    Y2 -->|owner saudável| Y5[nega handover 409]
